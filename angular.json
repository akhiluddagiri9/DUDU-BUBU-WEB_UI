{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "dudu-bubu": {
      "projectType": "application",
      "schematics": {},
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/dudu-bubu",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "assets": [{ "glob": "**/*", "input": "src/public", "output": "/" }],
            "styles": ["src/styles.css"]
          },
          "configurations": {
            "production": { "optimization": { "fonts": false }, "outputHashing": "all", "budgets": [
              {"type": "initial", "maximumWarning": "900kb", "maximumError": "1.7mb"},
              {"type": "anyComponentStyle", "maximumWarning": "20kb", "maximumError": "40kb"}
            ]},
            "development": { "optimization": false, "extractLicenses": false, "sourceMap": true }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "development": { "buildTarget": "dudu-bubu:build:development" },
            "production": { "buildTarget": "dudu-bubu:build:production" }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  },
  "cli": { "analytics": false }
}
